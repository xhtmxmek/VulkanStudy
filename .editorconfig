# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# 모든 파일에 대해 UTF-8 인코딩 설정
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ 소스 파일
[*.{c,cpp,h,hpp}]
charset = utf-8
indent_style = tab
indent_size = 4

# HLSL/GLSL 셰이더 파일
[*.{hlsl,glsl,vert,frag}]
charset = utf-8
indent_style = tab
indent_size = 4

# CMake 파일
[CMakeLists.txt]
charset = utf-8
indent_style = space
indent_size = 4

# 프로젝트 파일
[*.{vcxproj,sln}]
charset = utf-8


